{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Wildlife records per year in the eight capital cities, by animal group (log scale), 2010 to 2024.",
  "width": 440,
  "height": 330,
  "padding": {"left": 5, "top": 5, "bottom": 5, "right": 24},
  "data": {
    "url": "data/records_by_year_group.csv",
    "format": {"type": "csv", "parse": {"year": "number", "records": "number", "index_2015": "number"}}
  },
  "transform": [{"filter": "datum.year <= 2024"}],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {"domain": [2010, 2024], "nice": false},
      "axis": {"format": "d", "title": "Year", "values": [2010, 2012, 2014, 2016, 2018, 2020, 2022, 2024], "grid": false}
    },
    "y": {
      "field": "records",
      "type": "quantitative",
      "scale": {"type": "log", "domain": [2000, 6000000]},
      "axis": {
        "title": "Records per year (log scale)",
        "format": "~s",
        "values": [3000, 10000, 30000, 100000, 300000, 1000000, 3000000]
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": ["Birds", "Mammals", "Reptiles", "Insects"],
        "range": ["#2a78d6", "#e34948", "#1baf7a", "#eda100"]
      },
      "legend": {"title": "Click to highlight", "orient": "top", "direction": "horizontal"}
    },
    "opacity": {"condition": {"param": "hl", "value": 1}, "value": 0.15}
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5},
      "params": [{"name": "hl", "select": {"type": "point", "fields": ["group"]}, "bind": "legend"}]
    },
    {
      "mark": {"type": "circle", "size": 40, "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "group", "title": "Group"},
          {"field": "year", "title": "Year"},
          {"field": "records", "title": "Records", "format": ","}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.year == 2024"}],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 12, "fontWeight": 600},
      "encoding": {"text": {"field": "group"}, "color": {"value": "#55534d"}}
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#55534d", "titleColor": "#55534d", "labelFontSize": 12, "titleFontSize": 12,
      "titleFontWeight": 600, "gridColor": "#e1e4da", "domainColor": "#c9c5ba", "tickColor": "#c9c5ba",
      "labelFont": "Source Sans 3", "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelColor": "#55534d", "titleColor": "#55534d", "labelFontSize": 12, "titleFontSize": 12,
      "titleFontWeight": 600, "labelFont": "Source Sans 3", "titleFont": "Source Sans 3"
    },
    "text": {"font": "Source Sans 3", "color": "#55534d"},
    "tooltip": {"content": "data"}
  }
}
