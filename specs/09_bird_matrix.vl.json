{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": {
    "left": 64,
    "top": 5,
    "right": 5,
    "bottom": 5
  },
  "description": "Dot matrix: birds in the top-10 most-recorded list of at least two capital cities; dot size = share of that city's bird records, number = rank.",
  "width": {
    "step": 74
  },
  "height": {
    "step": 30
  },
  "data": {
    "url": "data/top10_species_city_group.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "records": "number",
        "share_of_group_records": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group == 'Birds'"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "ncities"
        },
        {
          "op": "sum",
          "field": "records",
          "as": "tot"
        }
      ],
      "groupby": [
        "common_name"
      ]
    },
    {
      "filter": "datum.ncities >= 2"
    },
    {
      "calculate": "datum.common_name + ' (' + datum.ncities + ')'",
      "as": "label"
    },
    {
      "calculate": "datum.origin == 'Introduced' ? 'Introduced' : 'Native'",
      "as": "origin"
    }
  ],
  "encoding": {
    "x": {
      "field": "city",
      "type": "nominal",
      "sort": [
        "Sydney",
        "Melbourne",
        "Brisbane",
        "Perth",
        "Adelaide",
        "Canberra",
        "Hobart",
        "Darwin"
      ],
      "axis": {
        "title": null,
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 12.5,
        "labelFontWeight": 700,
        "labelColor": "#22211d",
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#e8ebe2"
      }
    },
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
        "field": "tot",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 12.5,
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#e8ebe2",
        "labelPadding": 8,
        "labelLimit": 240
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "size": {
          "field": "share_of_group_records",
          "type": "quantitative",
          "scale": {
            "range": [
              40,
              720
            ],
            "domain": [
              0,
              7
            ]
          },
          "legend": {
            "title": "% of the city's bird records",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              1,
              3,
              5
            ],
            "symbolFillColor": "#2a78d6"
          }
        },
        "color": {
          "value": "#2a78d6"
        },
        "tooltip": [
          {
            "field": "common_name",
            "title": "Bird"
          },
          {
            "field": "scientific_name",
            "title": "Scientific name"
          },
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "rank",
            "title": "Rank in city"
          },
          {
            "field": "records",
            "title": "Records 2020–24",
            "format": ","
          },
          {
            "field": "share_of_group_records",
            "title": "% of city's bird records",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 700,
        "color": "#ffffff"
      },
      "encoding": {
        "text": {
          "field": "rank"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#55534d",
      "titleColor": "#55534d",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "gridColor": "#e1e4da",
      "domainColor": "#c9c5ba",
      "tickColor": "#c9c5ba",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelColor": "#55534d",
      "titleColor": "#55534d",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "header": {
      "labelColor": "#22211d",
      "labelFontSize": 14,
      "labelFontWeight": 600,
      "labelFont": "Source Sans 3",
      "titleFontSize": 0
    },
    "text": {
      "font": "Source Sans 3",
      "color": "#55534d"
    },
    "tooltip": {
      "content": "data"
    }
  }
}